# Database
DB_NAME=timedrop.sqlite

# JWT
JWT_SECRET=your_jwt_secret_here_for_local_development_only

# Server: HOST=0.0.0.0 so the app on your network can reach http://YOUR_IP:3000
PORT=3000
HOST=0.0.0.0

# WhatsApp (optional for local dev)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

NODE_ENV=development
